# Copy to .env for local development. Never commit the real .env.
AWS_REGION=ap-south-1

# DynamoDB
CLOUDGUARD_FINDINGS_TABLE=CloudGuardFindings

# SNS topic ARN for alerts (from the CloudFormation stack output)
CLOUDGUARD_ALERTS_TOPIC_ARN=

# Bedrock model id you were granted access to (e.g. amazon.nova-lite-v1:0
# or an Anthropic Claude model id available in your account/region)
CLOUDGUARD_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Only alert on findings at or above this severity score
CLOUDGUARD_ALERT_THRESHOLD=80

# Remediation is off by default; set to true to allow approved fixes to run
CLOUDGUARD_REMEDIATION_ENABLED=false
